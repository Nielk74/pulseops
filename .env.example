# Start locally with every source mocked. Set MOCK_ALL=false to opt into
# source-by-source selection below.
MOCK_ALL=true
MOCK_TEAMCITY=false
MOCK_DEPLOYMENTS=false
MOCK_SERVICES=false
MOCK_GIT=false
MOCK_ORACLE=false
MOCK_MACHINES=false

DATABASE_URL=./data/pulseops.db
APP_ENVIRONMENT=DEV2
ENABLE_POLLING=false
AUTO_MIGRATE=false

POLL_TEAMCITY_SECONDS=30
POLL_DEPLOYMENTS_SECONDS=30
POLL_SERVICES_SECONDS=15
POLL_GIT_SECONDS=60
POLL_ORACLE_SECONDS=30
POLL_MACHINES_SECONDS=600

TEAMCITY_BASE_URL=
TEAMCITY_TOKEN=
DEPLOYMENTS_API_URL=
DEPLOYMENTS_API_TOKEN=
SERVICES_API_URL=
SERVICES_API_TOKEN=
GIT_REPOSITORY_PATH=
GIT_REMOTE=origin
GIT_BRANCH=main
ORACLE_CONNECT_STRING=
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_APPLICATION_QUERY=
WINDOWS_EXECUTOR_URL=
WINDOWS_EXECUTOR_TOKEN=

# A trusted reverse proxy can inject identity headers after OIDC authentication.
AUTH_TRUSTED_PROXY=false
AUTH_DEFAULT_ROLE=VIEWER
